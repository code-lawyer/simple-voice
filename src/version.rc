#include <winver.h>
#include "product.hpp"

1 VERSIONINFO
FILEVERSION SIMPLE_VOICE_FILE_VERSION
PRODUCTVERSION SIMPLE_VOICE_FILE_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
#ifdef SIMPLE_VOICE_DLL
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Simple Voice contributors\0"
      VALUE "FileDescription", "Simple Voice - Chinese pinyin and offline voice input\0"
      VALUE "FileVersion", SIMPLE_VOICE_VERSION "\0"
      VALUE "ProductName", "Simple Voice\0"
      VALUE "ProductVersion", SIMPLE_VOICE_VERSION "\0"
      VALUE "LegalCopyright", "Copyright (c) 2026 Simple Voice contributors\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
